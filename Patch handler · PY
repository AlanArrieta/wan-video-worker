#!/usr/bin/env python3
"""
Parche build-time para worker-comfyui (>= 5.x).

Problema: VHS_VideoCombine escribe su salida de video bajo node_output["gifs"],
pero el handler oficial solo recolecta node_output["images"]. Resultado:
el job COMPLETA pero devuelve images vacio (success_no_images) y no hay .mp4.

Solucion: ANTES del loop que ya existe, normalizamos gifs -> images. Asi el .mp4
se sube a R2/S3 (o se devuelve en base64) reutilizando INTACTA la logica de subida
del handler. No tocamos nada del flujo de subida.

Diseno a prueba de gasto: si no encuentra el handler o el ancla, SALE CON ERROR.
El build truena aqui (en CPU, gratis), nunca en una corrida de GPU.
"""
import subprocess
import sys

ANCHOR = 'if "images" in node_output:'


def find_handler() -> str | None:
    res = subprocess.run(
        ["bash", "-lc", "find / -maxdepth 6 -name handler.py 2>/dev/null"],
        capture_output=True,
        text=True,
    )
    candidates = [p for p in res.stdout.splitlines() if p.strip()]
    # rutas mas cortas primero (/handler.py, /src/handler.py, ...)
    candidates.sort(key=len)
    for path in candidates:
        try:
            if ANCHOR in open(path, encoding="utf-8").read():
                return path
        except Exception:
            continue
    print(f"[patch-mp4] Candidatos encontrados: {candidates}", file=sys.stderr)
    return None


def main() -> None:
    target = find_handler()
    if not target:
        sys.exit(
            f"[patch-mp4] ERROR: no encontre un handler.py que contenga el ancla "
            f"{ANCHOR!r}. La estructura del worker cambio; avisa para ajustar el ancla."
        )

    src = open(target, encoding="utf-8").read()

    # Si ya esta parcheado (rebuild), no duplicar.
    if 'node_output["images"] = node_output["gifs"]' in src:
        print(f"[patch-mp4] Ya estaba parcheado -> {target}")
        return

    # Respetar la indentacion exacta de la linea ancla.
    indent = next(
        line[: len(line) - len(line.lstrip())]
        for line in src.splitlines()
        if ANCHOR in line
    )
    inject = (
        f'{indent}# [patch-mp4] tratar la salida de video (gifs) como images\n'
        f'{indent}if "gifs" in node_output and "images" not in node_output:\n'
        f'{indent}    node_output["images"] = node_output["gifs"]\n'
    )

    src = src.replace(indent + ANCHOR, inject + indent + ANCHOR, 1)
    open(target, "w", encoding="utf-8").write(src)
    print(f"[patch-mp4] OK -> {target}")


if __name__ == "__main__":
    main()
